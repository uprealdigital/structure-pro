# Twilio (trial is fine for your verified personal number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Public URL Twilio should POST to (ngrok/Cloudflare tunnel + /api/twilio/sms).
# Must match the "A message comes in" webhook exactly or signature checks fail.
TWILIO_WEBHOOK_URL=https://YOUR-TUNNEL/api/twilio/sms

# Gemini
GEMINI_API_KEY=
# Optional override; default is gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP via Nodemailer (use an App Password)
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM="TimberCraft Shed <you@gmail.com>"

# Invoice header / footer (optional)
COMPANY_NAME=TIMBERCRAFT SHED LLC
COMPANY_SLOGAN=TENNESSEE
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_EMAIL=you@gmail.com
COMPANY_PHONE=
COMPANY_WEBSITE=
COMPANY_ACCOUNT_NAME=
COMPANY_ACCOUNT_NUMBER=

# Demo setup
# 1. Copy this file to .env.local and fill in the values.
# 2. npm run dev
# 3. Tunnel localhost:3000 (ngrok http 3000).
# 4. Twilio Console → Phone Numbers → your number → Messaging
#    A message comes in: https://<tunnel>/api/twilio/sms  HTTP POST
# 5. Set TWILIO_WEBHOOK_URL to that same URL, restart next dev.
# 6. Submit for Quote with your verified cell and Gmail.
