# Quote follow-up channel: twilio (SMS) or telegram
QUOTE_CHANNEL=telegram

# Twilio — keep these even when using Telegram so you can switch later
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Public URL Twilio should POST to. Must match "A message comes in" exactly.
TWILIO_WEBHOOK_URL=https://structure-pro.vercel.app/api/twilio/sms

# Telegram (used when QUOTE_CHANNEL=telegram)
TELEGRAM_BOT_TOKEN=
# Numeric chat id from getUpdates after you tap Start on the bot
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://structure-pro.vercel.app/api/telegram
# Optional. If set, Telegram must send this as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Supabase. Required so a reply can find the quote after the first message.
# Project Settings → API: Project URL and the service_role secret.
# Run supabase/schema.sql in the SQL Editor first. Keep the service role key
# on the server only (Vercel env and .env.local). Do not use the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
# Optional override; default is gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional override; default is gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Gmail SMTP via Nodemailer (use an App Password)
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM="TimberCraft Shed <you@gmail.com>"

# Invoice header / footer (optional)
# First name used in the opening message (“Daniel from …”)
COMPANY_CONTACT_NAME=Daniel
COMPANY_NAME=TIMBERCRAFT SHED LLC
COMPANY_SLOGAN=TENNESSEE
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_EMAIL=you@gmail.com
COMPANY_PHONE=
COMPANY_WEBSITE=
COMPANY_ACCOUNT_NAME=
COMPANY_ACCOUNT_NUMBER=

# Telegram demo setup
# 1. Message @BotFather, /newbot, copy the token → TELEGRAM_BOT_TOKEN
# 2. /setname to a phone-looking title if you want
# 3. Open your bot in Telegram and tap Start
# 4. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id
#    → TELEGRAM_CHAT_ID
# 5. Set QUOTE_CHANNEL=telegram and TELEGRAM_WEBHOOK_URL to this app + /api/telegram
# 6. Redeploy. Submit a quote; the first message goes to that Telegram chat.
# 7. After the demo, set QUOTE_CHANNEL=twilio (and keep Twilio webhook pointed at /api/twilio/sms)
